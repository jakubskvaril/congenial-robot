# Supabase — viz supabase/schema.sql
# Získáš z: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Automatické přihlášení — aplikace se sama přihlásí tímto účtem,
# login screen se nikdy nezobrazí. Heslo nastav na SVÉM STÁVAJÍCÍM účtu
# v Supabase (Authentication → Users → tvůj účet), NIKDY nevytvářej nový
# účet — měl by jiné user_id a historie by zmizela z dohledu.
# POZOR: údaje jsou viditelné v JS bundlu — používej jen pro osobní aplikaci.
VITE_APP_EMAIL=vas@email.cz
VITE_APP_PASSWORD=silne-heslo

# Pojistka (doporučeno): UUID účtu, který vlastní data
# (Supabase → Authentication → Users → sloupec UID).
# Když se auto-login přihlásí pod jiným účtem, aplikace se odhlásí
# místo tichého rozdvojení historie.
VITE_APP_EXPECTED_USER_ID=

# Ponech prázdné pro lokální vývoj bez cloudu (localStorage only)
