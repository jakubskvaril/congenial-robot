# Copy this file to ".env" and fill in your values. Never commit .env.

# ---- E-mail (SMTP) ---------------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
#        SMTP_PASSWORD = a 16-character "App password" (not your normal password).
# Seznam.cz: SMTP_HOST=smtp.seznam.cz, SMTP_PORT=465, SMTP_SECURITY=ssl
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-app-password-here
# Sender address (defaults to SMTP_USER if empty)
EMAIL_FROM=
# One or more recipients, separated by commas
EMAIL_TO=your.address@gmail.com

# ---- Monitoring ------------------------------------------------------------
TARGET_URL=https://whitewitch.cz/en/for-sale/
# How often to check the for-sale page (seconds)
CHECK_INTERVAL_SECONDS=60
# How often to re-read each cat's own page for changes that only appear there (seconds)
DETAIL_REFRESH_SECONDS=300
# A cat must be missing on this many successful checks in a row before "removed" is sent
REMOVAL_CONFIRMATIONS=2
HTTP_TIMEOUT_SECONDS=20

# ---- Advanced: only if the website layout confuses the parser --------------
# CSS selector of the area that contains the listings, e.g. .entry-content
CONTENT_SELECTOR=
# Regular expression that every individual cat link must match, e.g. /kitten/
CAT_LINK_PATTERN=
