# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/walkthrough_ai"
DIRECT_URL="postgresql://user:password@localhost:5432/walkthrough_ai"

# ---------------------------------------------------------------------------
# Redis (BullMQ job queue + rate limiting + caching)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth — Clerk
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---------------------------------------------------------------------------
# Storage — choose ONE provider; StorageClient reads STORAGE_PROVIDER
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="s3" # "s3" | "supabase"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="walkthrough-ai-uploads"

# Supabase Storage (alternative)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="walkthrough-ai-uploads"

# UploadThing (client-facing resumable upload widget)
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# AI — vision/language understanding agents (Agents 1-4)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Video generation providers (Agent 5) — enable whichever you have access to
# ---------------------------------------------------------------------------
VIDEO_PROVIDER_DEFAULT="veo" # "veo" | "kling" | "runway" | "hailuo"

GOOGLE_VEO_API_KEY=""
GOOGLE_VEO_PROJECT_ID=""

KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""

RUNWAY_API_KEY=""

HAILUO_API_KEY=""

# Public base URL — used to build provider webhook callback URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Billing — Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_STARTER=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
NEXT_PUBLIC_STRIPE_PRICE_STUDIO=""

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
